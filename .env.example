# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Put the database name before the "?":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bluecollarjobs?retryWrites=true&w=majority
MONGO_URI=

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Frontend URLs allowed to call the API (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:4173,https://bluecollarjobs-frontend.vercel.app

# Used by `npm run seed` / `npm run create-admin` to create the first admin account
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the frontend (used in email links and the sitemap)
FRONTEND_URL=https://bluecollarjobs-frontend.vercel.app

# Cloudinary — CV and logo uploads (Dashboard → API Keys). Files go into the "jobzdxb" folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jobzdxb

# Brevo — emails (SMTP & API → API Keys). MAIL_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Jobz Dxb
# Where new-application and contact-form alerts go
ADMIN_NOTIFY_EMAIL=
